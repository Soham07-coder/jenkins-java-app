<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- CORE PROJECT IDENTIFICATION -->
    <groupId>com.soham</groupId>
    <artifactId>jenkins-hello-world</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging> 

    <name>Jenkins Hello World App</name>

    <!-- PROPERTIES (Set Java version) -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!-- DEPENDENCIES (Empty for this simple project) -->
    <dependencies>
        <!-- No dependencies needed for a basic System.out.println -->
    </dependencies>

    <!-- BUILD CONFIGURATION (Crucial for creating an executable JAR) -->
    <build>
        <plugins>
            <!-- 1. Plugin to configure the Main Class for the JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- IMPORTANT: This must match your package and class name -->
                            <mainClass>com.soham.HelloWorld</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
             <!-- 2. Plugin to specify compiler settings -->
             <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
